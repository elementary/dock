#: data/dock.metainfo.xml.in:119
msgid "Updated translations"
msgstr "Terjemahan diperbarui"

#: data/dock.metainfo.xml.in:93
msgid "Open context menus with long-press"
msgstr "Buka menu konteks dengan tekan lama"

#: data/dock.metainfo.xml.in:94
msgid "Cycle through windows when hovering over an app with drag-and-drop"
msgstr ""
"Beralih antar jendela saat mengarahkan kursor ke aplikasi dengan seret-dan-"
"lepas"

#: data/dock.metainfo.xml.in:95
msgid "Improve memory usage"
msgstr "Tingkatkan penggunaan memori"

#: data/dock.metainfo.xml.in:96
msgid "Fix dock bounds when hide mode is 'Never'"
msgstr "Perbaiki batas dock saat mode sembunyi adalah 'Tidak pernah'"

#: data/dock.metainfo.xml.in:120
msgid "Fixes a crash when dragging a file that's not a launcher to the dock"
msgstr "Perbaiki mogok saat menyeret berkas yang bukan peluncur ke dock"

#: data/dock.metainfo.xml.in:121
msgid ""
"Hide badges, progressbars, and running indicators while dragging a launcher"
msgstr ""
"Sembunyikan lencana, bilah kemajuan, dan indikator berjalan saat menyeret "
"peluncur"

#: data/dock.metainfo.xml.in:135
msgid "Complete rewrite 🎉️"
msgstr "Penulisan ulang menyeluruh 🎉️"

#: data/dock.metainfo.xml.in:11
msgid "Dock"
msgstr "Dock"

#: data/dock.metainfo.xml.in:12
msgid "Launch apps and switch between them"
msgstr "Jalankan aplikasi dan beralih di antaranya"

#: data/dock.metainfo.xml.in:21
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/dock.metainfo.xml.in:29 data/dock.metainfo.xml.in:40
#: data/dock.metainfo.xml.in:53 data/dock.metainfo.xml.in:65
#: data/dock.metainfo.xml.in:80 data/dock.metainfo.xml.in:86
